# EVN Post-Processing Communications Configuration
#
# Copy this file to one of the following locations:
#   ./comms.toml                        (per-experiment, highest priority)
#   $XDG_CONFIG_HOME/evn/comms.toml     (user-level)
#   ~/.config/evn/comms.toml            (user-level fallback)
#   ~jops/.config/evn/comms.toml        (shared jops account)
#
# Or point to it explicitly:  postprocess --comms /path/to/comms.toml run

# Communication mode: "none", "email", or "mattermost"
mode = "none"

# Who to notify, as an email address (email mode) or a Mattermost username (mattermost
# mode). Leave it EMPTY on a shared account (jops): postprocess then notifies the support
# scientist assigned to each experiment, looked up in the [[people]] table below. Setting
# it here overrides that and always notifies the same person.
username = ""

# ---------- Support scientists (the people directory) ----------
# One entry per support scientist, mapping the name postprocess knows them by to the
# addresses used by each mode. Add everybody here, once, in the shared configuration
# (~jops/.config/evn/comms.toml).
#
#   username    the name the rest of the program uses: the login on eee, the `-jss`
#               argument, and the `support` field of the experiment .jex file.
#               Matched case-insensitively.
#   email       address used in mode = "email".
#   mattermost  username (without the '@') used in mode = "mattermost".
#
# [[people]]
# username = "marcote"
# email = "marcote@jive.eu"
# mattermost = "marcote"
#
# [[people]]
# username = "nair"
# email = "nair@jive.eu"
# mattermost = "dnair"

# ---------- Email settings (mode = "email") ----------
[email]
smtp_host = "smtp.example.com"
smtp_port = 587
from_address = ""   # Sender address; defaults to 'username' if empty
# Password can also be set via the POSTPROCESS_SMTP_PASSWORD environment variable
password = ""

# ---------- Mattermost settings (mode = "mattermost") ----------
[mattermost]
server_url = "https://mattermost.example.com"
# Personal access token for the bot/user account.
# Can also be set via the POSTPROCESS_MM_TOKEN environment variable.
token = ""
# Optional: fixed channel ID for notifications.
# If empty, a direct-message channel with 'username' is created automatically.
channel_id = ""
